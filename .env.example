# Shared secret; callers send it as the X-API-Key header. deploy.sh --first generates one on the server.
ETA_KEY=
# Waze region: IL, EU, US, AU
WAZE_REGION=IL
# Time zone for depart_at values without an offset
TZ_NAME=Asia/Jerusalem
PORT=8080
# Where device locations are kept, and how old the freshest may be to count as "me"
LOCATION_PATH=data/location.json
LOCATION_MAX_AGE_H=24
